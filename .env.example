# Local SQLite storage. Deployment may replace this adapter without changing Project contracts.
DATABASE_URL=file:./data/wonder.sqlite

# Hila's single configured owner identity. Production requires all three;
# local development and tests fall back to clearly labelled fictional values.
# Generate the hash with: npm run owner:hash-password -- "choose-a-strong-password"
WONDER_OWNER_EMAIL=
WONDER_OWNER_PASSWORD_HASH=
WONDER_SESSION_SECRET=

# Optional session lifetime in seconds (default 43200 = 12 hours, range 60-2592000).
WONDER_SESSION_MAX_AGE_SECONDS=
